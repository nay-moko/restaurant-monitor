# Project Configuration
PROJECT_NAME="Restaurant Floor Monitoring Backend"

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/restaurant_db

# JWT Authentication Configuration
JWT_SECRET_KEY=your-secure-random-minimum-32-byte-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# OTP Configuration
OTP_EXPIRE_MINUTES=10

# Development Mode
DEV_MODE=true  # Set to true to return OTP in response for testing

# Initial Admin Configuration
INITIAL_ADMIN_EMAIL="admin@restaurant.com"
INITIAL_ADMIN_PASSWORD="admin123"

# Camera streaming / AI control
# AI_ENABLED_CAMERAS: الكاميرات اللي بيشتغل عليها الـ AI pipeline الكامل
AI_ENABLED_CAMERAS=camera_01
# STREAMING_ENABLED_CAMERAS: الكاميرات المسموح تفتح stream أساسًا (خام أو AI)
STREAMING_ENABLED_CAMERAS=camera_01,camera_02,camera_04,camera_05,camera_06,camera_07